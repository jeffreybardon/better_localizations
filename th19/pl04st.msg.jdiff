        },
        "66_0": {
            "lines": [
                "The animal spirits are excited."
            ]
        },
        "74_0": {
            "lines": [
                "I wonder if the incident is influencing that."
            ]
        },
        "82_0": {
            "lines": [
                "Where are you trying to go,",
                "Miss Reimu?"
            ]
        },
        "90_0": {
            "lines": [
                "I don't need to tell you."
            ]
        },
        "98_0": {
            "lines": [
                "Heeh, you're going to the beast world?"
            ]
        },
        "106_0": {
            "lines": [
                "Huh?",
                "What's that...?"
            ]
        },
        "114_0": {
            "lines": [
                "I heard some whispers just now."
            ]
        },
        "122_0": {
            "lines": [
                "Be careful!",
                "There will be a trap for sure."
            ]
        },
        "130_0": {
            "lines": [
                "Well, I have to stop you right here!"
            ]
        },
        "4_0": {
            "lines": [
                "I'm getting excited!"
            ]
        },
        "12_0": {
            "lines": [
                "I haven't left the shrine for so long!"
            ]
        },
        "116_0": {
            "lines": [
                "Who's that?"
            ]
        },
        "144_0": {
            "lines": [
                "Oh, a komainu."
            ]
        },
        "152_0": {
            "lines": [
                "Hm?",
