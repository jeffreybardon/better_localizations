            ]
        },
        "160_0": {
            "lines": [
                "I'm surprised you've heard of us."
            ]
        },
        "168_0": {
            "lines": [
                "Well, I learned about you from a friend."
            ]
        },
        "176_0": {
            "lines": [
                "Ah well, you don't have the thing I'm looking for."
            ]
        },
        "184_0": {
            "lines": [
                "So you're no use to me.",
                "Get outta my sight!"
            ]
        }
    },
    "5": {
        "34_0": {
            "lines": [
                "Aagh, where could I have dropped it?"
            ]
        }
    },
    "4": {
        "34_0": {
            "lines": [
                "Welcome to Earth!",
