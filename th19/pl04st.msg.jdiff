            ]
        },
        "74_0": {
            "lines": [
                "Hm, I see."
            ]
        },
        "4_0": {
            "lines": [
                "Wow, it's so noisy all of a sudden.",
                "What's going on?"
            ]
        },
        "116_0": {
            "lines": [
                "Oh, Aunn."
            ]
        },
        "144_0": {
            "lines": [
                "What are you doing here of all places?"
            ]
        },
        "152_0": {
            "lines": [
                "Ah, Miiiss Reimu?"
            ]
        },
        "160_0": {
            "lines": [
                "M-Miiiss?"
            ]
        },
        "12_0": {
            "lines": [
                "It's like there's this sound I can't stop hearing."
            ]
        },
        "168_0": {
            "lines": [
                "Wow, you're really Miiiss Reimu!",
                "Are you working on the incident?"
            ]
        },
        "176_0": {
            "lines": [
                "You're acting awfully...excitable."
            ]
        },
        "184_0": {
            "lines": [
                "And the beast spirits are agitated as well."
            ]
        },
        "192_0": {
            "lines": [
                "It looks like the incident's having an effect on you."
            ]
        },
        "200_0": {
            "lines": [
                "Go back to the shrine and stay put!"
            ]
        }
    },
    "10": {
        "34_0": {
            "lines": [
                "There's no way I can stay put when it's so noisy!"
            ]
        },
        "42_0": {
            "lines": [
                "Well, try not to give the shrine a bad name."
