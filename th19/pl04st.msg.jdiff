            ]
        },
        "4_0": {
            "lines": [
                "Oh wooow, really?"
            ]
        },
        "12_0": {
            "lines": [
                "Ahahaha.",
                "Who would've thought Sanae was into that kind of stuff?"
            ]
        },
        "20_0": {
            "lines": [
                "...Eh?",
                "A tanuki?"
