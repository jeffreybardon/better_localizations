        },
        "124_0": {
            "lines": [
                "Heya."
            ]
        },
        "152_0": {
            "lines": [
                "What are you mumbling about all to yourself?"
            ]
        },
        "184_0": {
            "lines": [
                "Hey, you're in big trouble.",
                "Inside your hair..."
            ]
        }
    },
    "13": {
        "34_0": {
            "lines": [
                "What's a tube-fox plotting, steering the shrine's komainu?"
            ]
        },
        "42_0": {
            "lines": [
                "......"
            ]
        },
        "50_0": {
            "lines": [
