            ]
        },
        "168_0": {
            "lines": [
                "And it's been so much fun!"
            ]
        },
        "176_0": {
            "lines": [
                "Whispering?",
                "Lemme have a look."
            ]
        },
        "192_0": {
            "lines": [
                "What?",
