    },
    "11": {
        "34_0": {
            "lines": [
                "I have to hurry up and exorcise the beast spirits."
            ]
        }
    },
    "12": {
        "34_0": {
            "lines": [
                "Who could you be?"
            ]
        },
        "42_0": {
            "lines": [
                "You ask who I am?"
            ]
        },
        "50_0": {
            "lines": [
                "You'll know when I dominate you,",
