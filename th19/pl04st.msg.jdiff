    },
    "15": {
        "4_0": {
            "lines": [
                "I nearly got murdered by that tanuki."
            ]
        },
        "12_0": {
            "lines": [
                "...What is it now?"
            ]
        },
        "20_0": {
            "lines": [
                "Eh? I have to break in the guy who's about to show up?"
            ]
        },
        "28_0": {
            "lines": [
                "Break them in...",
                "Are they a beast or something?"
            ]
        },
        "132_0": {
            "lines": [
                "Who's there?"
            ]
        },
        "168_0": {
            "lines": [
                "W-who are you?"
            ]
        },
        "176_0": {
            "lines": [
                "My name is Son Biten!"
            ]
        },
        "192_0": {
            "lines": [
                "You want me to break <i$her> in?",
                "Uh, that's not happening."
            ]
        },
        "160_0": {
            "lines": [
                "Prattling to yourself in my sanctuary!"
            ]
        },
        "184_0": {
            "lines": [
                "The Heavens of Gensokyo are within my grasp!",
                "You would do well to grovel!"
            ]
        },
        "200_0": {
            "lines": [
                "You've been talking to yourself for a while.",
                "Just who are you?"
            ]
        },
        "208_0": {
            "lines": [
                "Oh, I'm Aunn.",
                "The shrine's komainu."
            ]
        },
        "216_0": {
            "lines": [
                "What? Komainu?!"
            ]
        },
        "224_0": {
            "lines": [
                "Do you know what I hate more than anything else in the world?"
            ]
        },
        "232_0": {
            "lines": [
                "Why would I?",
                "We've never met before."
            ]
        },
        "240_0": {
            "lines": [
                "What I hate are dogs!",
                "And a dog who talks to herself is even worse!"
            ]
        },
        "248_0": {
            "lines": [
                "Get out of my face, shrine-dog!"
            ]
        }
    },
    "16": {
        "34_0": {
            "lines": [
                "Hold up, I was kidding, kidding!",
                "Just playing around a bit!"
            ]
        },
        "50_0": {
            "lines": [
                "By the way, are you with the Moriya Shrine?"
            ]
        },
        "58_0": {
            "lines": [
                "No, I work at the Hakurei Shrine."
            ]
        },
        "66_0": {
            "lines": [
                "Aaah, that place.",
                "Well, this is a surprise."
            ]
        },
        "74_0": {
            "lines": [
                "A surprise? Why?"
            ]
        },
        "90_0": {
            "lines": [
                "Eh? The Moriya Shrine...?"
            ]
        },
        "42_0": {
            "lines": [
                "Y'know, acting out the clichés about dog-monkey relationships."
            ]
        },
        "82_0": {
            "lines": [
                "I feel a certain youkai presence coming off you.",
                "I felt the same presence at the Moriya Shrine."
            ]
        },
        "98_0": {
            "lines": [
                "Have I gone there recently?"
            ]
        },
        "106_0": {
            "lines": [
                "This might sound rude, ",
                "but you're definitely being manipulated!"
            ]
        },
        "114_0": {
            "lines": [
                "M-manipulated...",
                "I think I know what you're talking about."
            ]
        },
        "122_0": {
            "lines": [
                "There aren't many people who'd resort to dirty tricks like these."
            ]
        },
        "130_0": {
            "lines": [
                "Only one comes to my mind!"
            ]
        },
        "138_0": {
            "lines": [
                "Who? And where?",
                "I'm gonna interrogate them!"
            ]
        },
        "146_0": {
            "lines": [
                "They're in Hell!",
                "Go to Hell!"
            ]
        }
    },
    "17": {
        "34_0": {
            "lines": [
                "Hold up, I was kidding, kidding!",
