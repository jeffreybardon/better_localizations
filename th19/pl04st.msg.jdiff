            ]
        },
        "58_0": {
            "lines": [
                "There it is again...",
                "A voice whispering into my ear..."
            ]
        }
    },
    "8": {
        "34_0": {
            "lines": [
                "Well, exorcising her was probably the right thing to do."
            ]
        }
    },
    "9": {
        "34_0": {
            "lines": [
                "Kyah, a rat!"
