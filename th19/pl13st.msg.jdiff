    "18": {
        "4_0": {
            "lines": [
                "Well, I guess the party is over."
            ]
        },
        "12_0": {
            "lines": [
                "Hey, Zanmu Nippaku."
            ]
        },
        "116_0": {
            "lines": [
                "Suika..."
            ]
        },
        "144_0": {
            "lines": [
                "You've been darting around all day.",
                "You're still a master at hide-and-seek."
            ]
        },
        "152_0": {
            "lines": [
                "It's about time for your operation to finish, ",
                "isn't it?"
            ]
        },
        "160_0": {
            "lines": [
                "Heheh, what are you saying?"
            ]
        },
        "168_0": {
            "lines": [
                "It's been over for a while."
            ]
        },
        "176_0": {
            "lines": [
                "By the time you noticed it,",
                "everything was over."
            ]
        },
        "184_0": {
            "lines": [
                "Seems so."
            ]
        },
        "192_0": {
            "lines": [
                "Your power of imagination to create the future...",
                "It's always amazed me to see."
            ]
        },
        "200_0": {
            "lines": [
                "What's that? You came here to flatter me?"
            ]
        },
        "208_0": {
            "lines": [
                "Brawn and brains are what oni are all about."
            ]
        },
        "216_0": {
            "lines": [
                "You should act a little more like an oni!"
            ]
        },
        "224_0": {
            "lines": [
                "In this finale, show me everything you've got! ",
                "Suika Ibuki!"
            ]
        }
    },
    "20": {
        "34_0": {
            "lines": [
                "Weakness is evil, you know."
            ]
